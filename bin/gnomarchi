#!/usr/bin/env python3
"""gnomarchi CLI — theme, plugin, menu, agent, bus, shell, install helpers."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def _resolve_root() -> Path:
    here = Path(__file__).resolve()
    candidates: list[Path] = []
    env = os.environ.get("GNOMARCHI_ROOT")
    if env:
        candidates.append(Path(env).expanduser())
    candidates.append(here.parent.parent)
    candidates.append(here.parent.parent / "lib" / "gnomarchi")
    candidates.append(here.parent / "lib")
    for root in candidates:
        if (root / "theme").is_dir() and (root / "plugin").is_dir():
            return root
    return candidates[0] if env else here.parent.parent


REPO_ROOT = _resolve_root()
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))
os.environ.setdefault("GNOMARCHI_ROOT", str(REPO_ROOT))


def cmd_theme_validate(args: argparse.Namespace) -> int:
    from theme.engine import validate_theme
    from theme.paths import find_pack

    pack = Path(args.path) if args.path else find_pack(args.id) if args.id else None
    if pack is None and args.id:
        print(f"error: theme not found: {args.id}", file=sys.stderr)
        return 1
    if pack is None:
        print("error: provide --path or --id", file=sys.stderr)
        return 2
    errors = validate_theme(pack)
    if errors:
        for err in errors:
            print(f"invalid: {err}", file=sys.stderr)
        return 1
    print(f"ok: {pack}")
    return 0


def cmd_theme_set(args: argparse.Namespace) -> int:
    from theme.engine import set_theme

    try:
        active = set_theme(args.id)
    except (FileNotFoundError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"active theme → {args.id} ({active})")
    return 0


def cmd_theme_list(_args: argparse.Namespace) -> int:
    from theme.engine import list_themes

    themes = list_themes()
    if not themes:
        print("(no themes)")
        return 0
    for t in themes:
        print(f"{t['id']}\t{t['name']}\t{t['path']}")
    return 0


def cmd_theme_pick(_args: argparse.Namespace) -> int:
    """Open GTK theme carousel (falls back to CLI list)."""
    import subprocess

    picker = REPO_ROOT / "apps" / "theme-picker" / "gnomarchi_theme_picker.py"
    if picker.is_file():
        return subprocess.call([sys.executable, str(picker), "--gui"])
    return cmd_theme_list(_args)


def cmd_theme_bg_current(_args: argparse.Namespace) -> int:
    from theme.backgrounds import current_index

    print(current_index())
    return 0


def cmd_theme_bg_next(_args: argparse.Namespace) -> int:
    from theme.backgrounds import next_background

    try:
        path = next_background()
    except (FileNotFoundError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"background → {path}")
    return 0


def cmd_theme_bg_set(args: argparse.Namespace) -> int:
    from theme.backgrounds import set_background

    try:
        path = set_background(int(args.index))
    except (FileNotFoundError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"background → {path}")
    return 0


def cmd_theme_bg_video(args: argparse.Namespace) -> int:
    from theme.emitters import set_video_wallpaper_enabled, video_wallpaper_enabled
    from theme.engine import set_theme
    from theme.paths import state_dir

    if args.video_action == "status":
        print("on" if video_wallpaper_enabled() else "off")
        return 0
    on = args.video_action == "on"
    set_video_wallpaper_enabled(on)
    if on:
        active = (state_dir() / "active-theme").read_text(encoding="utf-8").strip()
        if active:
            set_theme(active)
    print("video wallpaper →", "on" if on else "off")
    return 0


def cmd_update(args: argparse.Namespace) -> int:
    from common.arch_update import run_update

    return run_update(noconfirm=bool(args.noconfirm), sync_only=bool(args.sync))


def cmd_capture(args: argparse.Namespace) -> int:
    from apps import capture

    if args.capture_action == "shot":
        return capture.shot(area=bool(args.area))
    if args.capture_action == "ocr":
        return capture.ocr()
    if args.capture_action == "qr":
        return capture.qr()
    if args.capture_action == "record":
        return capture.record()
    return 2


def cmd_remind(args: argparse.Namespace) -> int:
    from apps import remind

    if args.remind_action == "add":
        try:
            item = remind.add(
                args.text,
                due_epoch=args.due,
                in_spec=getattr(args, "in_spec", None),
            )
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        print(item["id"], item["text"], item.get("due") or "")
        return 0
    if args.remind_action == "list":
        for item in remind.list_items(include_done=bool(args.all)):
            print(item["id"], item["text"], item.get("due") or "")
        return 0
    if args.remind_action == "due":
        for item in remind.due_now():
            print(item["id"], item["text"])
        return 0
    if args.remind_action == "done":
        ok = remind.complete(args.id)
        return 0 if ok else 1
    if args.remind_action == "clear":
        n = remind.clear_all()
        print(f"cleared {n}")
        return 0
    if args.remind_action == "mark-fired":
        return 0 if remind.complete(args.id) else 1
    return 2


def cmd_clipboard(args: argparse.Namespace) -> int:
    from apps import clipboard

    if args.clipboard_action == "history":
        return clipboard.history(limit=int(args.limit))
    if args.clipboard_action == "select":
        return clipboard.select(int(args.index))
    if args.clipboard_action == "ui":
        return clipboard.ui()
    return 2


def cmd_mode(args: argparse.Namespace) -> int:
    from desktop import modes

    if args.mode_action == "status":
        for line in modes.status_lines():
            print(line)
        return 0
    if args.mode_action == "dnd":
        on = args.state == "on" if args.state else not modes.dnd_enabled()
        modes.set_dnd(on)
        print("dnd", "on" if on else "off")
        return 0
    if args.mode_action == "night-light":
        on = args.state == "on" if args.state else not modes.night_light_enabled()
        modes.set_night_light(on)
        print("night-light", "on" if on else "off")
        return 0
    if args.mode_action == "stay-awake":
        on = args.state == "on" if args.state else not modes.stay_awake_enabled()
        modes.set_stay_awake(on)
        print("stay-awake", "on" if on else "off")
        return 0
    return 2


def cmd_panel(args: argparse.Namespace) -> int:
    from apps.panels import open_panel

    return open_panel(args.name, prefer_gtk=bool(getattr(args, "gtk", False)))


def cmd_font(args: argparse.Namespace) -> int:
    from common.fonts import current_monospace, install_font, list_fonts, set_monospace

    action = args.font_action
    if action == "list":
        cur = current_monospace() or ""
        for row in list_fonts():
            mark = "*" if row["family"] in cur else " "
            print(f"{mark} {row['id']}\t{row['label']}\t{row['family']}\t{row['package']}")
        if cur:
            print(f"# current: {cur}")
        return 0
    if action == "set":
        return set_monospace(args.family)
    if action == "install":
        return install_font(args.key)
    if action == "current":
        cur = current_monospace()
        print(cur or "(unset)")
        return 0
    return 2


def cmd_install_extra(args: argparse.Namespace) -> int:
    import subprocess

    if getattr(args, "extra", None) == "service":
        from desktop.services import install as svc_install, list_services

        name = getattr(args, "service_name", None)
        if not name:
            for s in list_services():
                print(s)
            return 0
        return svc_install(name, noconfirm=bool(args.yes))

    script = REPO_ROOT / "install" / "arch-extras.sh"
    if not script.is_file():
        print("error: install/arch-extras.sh missing", file=sys.stderr)
        return 1
    env = os.environ.copy()
    if args.yes:
        env["GNOMARCHI_SKIP_CONFIRM"] = "1"
    return subprocess.call(["bash", str(script), args.extra], env=env)


def cmd_notice(args: argparse.Namespace) -> int:
    from desktop import notices

    if args.notice_action == "all":
        return notices.demo_all()
    return notices.run(args.notice_action)


def cmd_webapp(args: argparse.Namespace) -> int:
    from desktop import webapps

    if args.webapp_action == "list":
        for row in webapps.list_apps():
            print(f"{row['id']}\t{row['name']}\t{row['url']}")
        return 0
    if args.webapp_action == "add":
        try:
            sid = webapps.add(args.name, args.url)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        print(sid)
        return 0
    if args.webapp_action == "remove":
        return 0 if webapps.remove(args.id) else 1
    if args.webapp_action == "launch":
        return webapps.launch(args.id)
    if args.webapp_action == "seed":
        created = webapps.seed_defaults()
        print("seeded", ", ".join(created) or "(none new)")
        return 0
    return 2


def cmd_share(args: argparse.Namespace) -> int:
    from desktop import share

    if args.share_action == "file":
        return share.share_file(args.path)
    if args.share_action == "folder":
        return share.share_folder(args.path)
    if args.share_action == "clipboard":
        return share.share_clipboard()
    if args.share_action == "receive":
        return share.receive()
    if args.share_action == "hint":
        print(share.install_hint())
        return 0
    return 2


def cmd_theme_new(args: argparse.Namespace) -> int:
    from theme.scaffold import new_theme

    try:
        dest = new_theme(
            args.id,
            name=getattr(args, "name", None),
            from_id=getattr(args, "from_id", None) or "tokyo-night",
        )
    except (ValueError, FileExistsError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(dest)
    return 0


def cmd_herdr(args: argparse.Namespace) -> int:
    from desktop import herdr

    return herdr.run(args.herdr_action, name=getattr(args, "name", "agent") or "agent")


def cmd_display(args: argparse.Namespace) -> int:
    from desktop import display_ctl

    if args.display_action == "list":
        return display_ctl.list_monitors()
    if args.display_action == "settings":
        return display_ctl.open_settings()
    if args.display_action == "scale":
        return display_ctl.set_scale(args.factor)
    if args.display_action == "status":
        return display_ctl.status_json()
    return 2


def cmd_idle(args: argparse.Namespace) -> int:
    from desktop import idle_ctl

    if args.idle_action == "lock":
        return idle_ctl.lock_now()
    if args.idle_action == "status":
        return idle_ctl.status()
    if args.idle_action == "stay-awake":
        state = getattr(args, "state", None)
        on = None if state is None else state == "on"
        return idle_ctl.stay_awake(on)
    if args.idle_action == "inhibit":
        return idle_ctl.inhibit_sleep(int(args.seconds))
    return 2


def cmd_config(args: argparse.Namespace) -> int:
    from desktop import config_sync

    if args.config_action == "status":
        return config_sync.status()
    if args.config_action == "init":
        return config_sync.init(getattr(args, "remote", None))
    if args.config_action == "pull":
        return config_sync.pull()
    if args.config_action == "push":
        return config_sync.push()
    if args.config_action == "export":
        return config_sync.export_bundle(args.path)
    return 2


def cmd_cliamp(_args: argparse.Namespace) -> int:
    from desktop import cliamp

    return cliamp.run()


def cmd_nvim_seed(args: argparse.Namespace) -> int:
    from desktop.nvim_seed import install

    path = install(force=bool(args.force))
    print(path)
    return 0


def cmd_app(args: argparse.Namespace) -> int:
    import shutil
    import subprocess

    mapping = {
        "write": REPO_ROOT / "apps" / "gnoma-write" / "main.py",
        "cut": REPO_ROOT / "apps" / "gnoma-cut" / "main.py",
        "calc": REPO_ROOT / "apps" / "gnoma-calc" / "main.py",
        "hype": REPO_ROOT / "apps" / "gnoma-hype" / "main.py",
        "signed": REPO_ROOT / "apps" / "gnoma-signed" / "main.py",
        "monologue": REPO_ROOT / "apps" / "gnoma-monologue" / "main.py",
    }
    path = mapping.get(args.name)
    if path is None or not path.is_file():
        print(f"error: unknown app {args.name}", file=sys.stderr)
        return 1
    # Prefer system Python for PyGObject / Pillow on Arch.
    py = "/usr/bin/python3" if Path("/usr/bin/python3").is_file() else sys.executable
    if not shutil.which(py):
        py = sys.executable
    return subprocess.call([py, str(path), *list(getattr(args, "app_args", []) or [])])


def cmd_plugin_validate(args: argparse.Namespace) -> int:
    from plugin.lifecycle import validate_plugin

    errors = validate_plugin(args.path)
    if errors:
        for err in errors:
            print(f"invalid: {err}", file=sys.stderr)
        return 1
    print(f"ok: {args.path}")
    return 0


def cmd_plugin_scaffold(args: argparse.Namespace) -> int:
    from plugin.lifecycle import scaffold_plugin

    try:
        target = scaffold_plugin(
            args.id,
            runtime=args.runtime,
            dest_root=args.dest,
            explicit_shell_extension=bool(args.explicit_shell_extension),
        )
    except (ValueError, FileExistsError, FileNotFoundError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"scaffolded: {target}")
    return 0


def cmd_plugin_list(_args: argparse.Namespace) -> int:
    from plugin.lifecycle import list_plugins

    plugins = list_plugins()
    if not plugins:
        print("(no plugins)")
        return 0
    for p in plugins:
        print(f"{p['id']}\t{p['runtime']}\t{p['path']}")
    return 0


def cmd_plugin_add(args: argparse.Namespace) -> int:
    from plugin.lifecycle import add_plugin

    try:
        target = add_plugin(
            args.path,
            confirm=bool(args.confirm),
            dest_root=args.dest,
        )
    except PermissionError as exc:
        print(f"refused: {exc}", file=sys.stderr)
        return 2
    except (ValueError, FileNotFoundError, FileExistsError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"added: {target}")
    return 0


def cmd_plugin_enable(args: argparse.Namespace) -> int:
    from plugin.lifecycle import enable_plugin, list_plugins
    from pathlib import Path as P

    path = P(args.path) if args.path else None
    if path is None and args.id:
        matches = [p for p in list_plugins() if p["id"] == args.id]
        if not matches:
            print(f"error: plugin not found: {args.id}", file=sys.stderr)
            return 1
        path = P(matches[0]["path"])
    if path is None:
        print("error: provide path or --id", file=sys.stderr)
        return 2
    try:
        msg = enable_plugin(path)
    except (ValueError, PermissionError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(msg)
    return 0


def cmd_plugin_clone(args: argparse.Namespace) -> int:
    from plugin.lifecycle import clone_plugin

    try:
        target = clone_plugin(args.id, dest_root=args.dest)
    except (FileNotFoundError, FileExistsError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"cloned: {target}")
    return 0


def cmd_menu_open(_args: argparse.Namespace) -> int:
    from menu.palette import open_menu

    return open_menu()


def cmd_agent_window(_args: argparse.Namespace) -> int:
    candidates = [
        REPO_ROOT / "apps" / "agents-window" / "agents_window.py",
        Path(__file__).resolve().parent.parent / "apps" / "agents-window" / "agents_window.py",
    ]
    for script in candidates:
        if script.is_file():
            import runpy

            sys.argv = [str(script)]
            runpy.run_path(str(script), run_name="__main__")
            return 0
    print("error: agents window not installed", file=sys.stderr)
    return 1


def cmd_agent_list(_args: argparse.Namespace) -> int:
    from agent.catalog import AGENTS
    from agent.default_agent import get_default_agent
    from agent.mise import which_agent

    default = get_default_agent()
    for aid, spec in AGENTS.items():
        mark = "*" if aid == default else " "
        path = which_agent(aid) or "-"
        print(f"{mark} {aid}\t{spec.label}\t{path}")
    return 0


def cmd_default_agent(args: argparse.Namespace) -> int:
    from agent.default_agent import get_default_agent, set_default_agent

    if not args.id:
        cur = get_default_agent()
        print(cur or "(none)")
        return 0 if cur else 1
    try:
        set_default_agent(args.id, install=not args.no_install)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"default agent → {args.id}")
    return 0


def cmd_agent_launch(args: argparse.Namespace) -> int:
    from agent.launch import launch_agent

    try:
        return launch_agent(args.id, unattended=bool(args.unattended))
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


def cmd_agent_prompt(args: argparse.Namespace) -> int:
    from agent.launch import run_prompt

    try:
        return run_prompt(args.prompt, agent_id=args.agent, skill=args.skill)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


def cmd_agent_make(args: argparse.Namespace) -> int:
    from agent.make import list_starters, make_something

    if not args.kind:
        for s in list_starters():
            print(f"{s['id']}\t{s['skill']}")
        return 0
    try:
        return make_something(args.kind, extra=args.extra or "")
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


def cmd_agent_usage(_args: argparse.Namespace) -> int:
    from agent.usage import read_usage, update_usage

    data = update_usage() if _args.refresh else read_usage()
    import json

    print(json.dumps(data, indent=2))
    return 0


def cmd_agent_account(args: argparse.Namespace) -> int:
    from agent import accounts

    try:
        if args.account_action == "list":
            for row in accounts.list_accounts(args.provider):
                mark = "*" if row.get("active") else " "
                print(f"{mark} {row['id']}\t{row.get('name')}\t{row.get('provider')}")
            return 0
        if args.account_action == "add":
            print(accounts.add_account(args.provider, args.name))
            return 0
        if args.account_action == "use":
            print(accounts.use_account(args.name))
            return 0
        if args.account_action == "remove":
            accounts.remove_account(args.name)
            print(f"removed {args.name}")
            return 0
        if args.account_action == "mode":
            enabled = args.mode == "auto"
            print(accounts.set_autoswitch(enabled, threshold=args.threshold or 95))
            return 0
    except (ValueError, KeyError, FileExistsError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 2


def cmd_agent_skills(_args: argparse.Namespace) -> int:
    from agent.skills import install_skills

    linked = install_skills()
    for p in linked:
        print(p)
    print(f"{len(linked)} skill links")
    return 0


def cmd_agent_crash(args: argparse.Namespace) -> int:
    from agent import crash

    try:
        if args.crash_action == "diagnose":
            return crash.diagnose(args.pid)
        if args.crash_action == "mute":
            items = crash.mute(args.name, off=bool(args.off))
            print("\n".join(items) or "(none muted)")
            return 0
        if args.crash_action == "watch":
            return crash.watch_once()
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 2


def cmd_agent_setup(_args: argparse.Namespace) -> int:
    from agent.mise import write_mise_agent_tools
    from agent.skills import install_skills
    from common.shell_config import ensure_user_shell_toml

    path = write_mise_agent_tools()
    linked = install_skills()
    shell = ensure_user_shell_toml()
    print(f"mise config → {path}")
    print(f"skills linked → {len(linked)}")
    print(f"shell.toml → {shell}")
    return 0


def cmd_bus_serve(args: argparse.Namespace) -> int:
    from bus import server

    if args.once:
        server.serve_once()
    else:
        server.serve_forever()
    return 0


def cmd_shell_show(_args: argparse.Namespace) -> int:
    from common.shell_config import load_shell_config
    import json

    print(json.dumps(load_shell_config(), indent=2))
    return 0


def cmd_shell_bar_position(args: argparse.Namespace) -> int:
    from common.bar_position import get_bar_position, set_bar_position

    if not args.position:
        print(get_bar_position())
        return 0
    try:
        pos = set_bar_position(args.position)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    if pos == "top":
        print(f"bar position → {pos} (stock GNOME top bar)")
    else:
        print(f"bar position → {pos} (dash-to-panel enabled)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gnomarchi",
        description="gnomarchi — stock GNOME omakase (not affiliated with Omarchy)",
    )
    sub = parser.add_subparsers(dest="group", required=True)

    theme = sub.add_parser("theme", help="theme pack validate / set / list")
    theme_sub = theme.add_subparsers(dest="action", required=True)
    tv = theme_sub.add_parser("validate")
    tv.add_argument("--path")
    tv.add_argument("--id")
    tv.set_defaults(func=cmd_theme_validate)
    ts = theme_sub.add_parser("set")
    ts.add_argument("id")
    ts.set_defaults(func=cmd_theme_set)
    tl = theme_sub.add_parser("list")
    tl.set_defaults(func=cmd_theme_list)
    tp = theme_sub.add_parser("pick", help="GTK theme carousel (Omarchy Style > Theme)")
    tp.set_defaults(func=cmd_theme_pick)
    tn = theme_sub.add_parser("new", help="scaffold user theme under ~/.config/gnomarchi/themes")
    tn.add_argument("id", help="theme directory id")
    tn.add_argument("--name", default=None, help="display name")
    tn.add_argument("--from", dest="from_id", default="tokyo-night", help="base pack to copy")
    tn.set_defaults(func=cmd_theme_new)
    tbg = theme_sub.add_parser("bg", help="cycle/set generated backgrounds")
    tbg_sub = tbg.add_subparsers(dest="bg_action", required=True)
    tbgn = tbg_sub.add_parser("next")
    tbgn.set_defaults(func=cmd_theme_bg_next)
    tbgc = tbg_sub.add_parser("current")
    tbgc.set_defaults(func=cmd_theme_bg_current)
    tbgs = tbg_sub.add_parser("set")
    tbgs.add_argument("index", type=int)
    tbgs.set_defaults(func=cmd_theme_bg_set)
    tbgv = tbg_sub.add_parser("video")
    tbgv.add_argument("video_action", choices=["on", "off", "status"])
    tbgv.set_defaults(func=cmd_theme_bg_video)

    upd = sub.add_parser("update", help="Arch pacman -Syu (official repos)")
    upd.add_argument("--noconfirm", action="store_true")
    upd.add_argument("--sync", action="store_true", help="pacman -Sy only")
    upd.set_defaults(func=cmd_update)

    cap = sub.add_parser("capture")
    cap_sub = cap.add_subparsers(dest="capture_action", required=True)
    caps = cap_sub.add_parser("shot")
