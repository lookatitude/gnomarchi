# Maintainer: gnomarchi contributors
# Experimental — not affiliated with Omarchy / Basecamp / DHH.
pkgname=gnomarchi
pkgver=0.0.1beta4
pkgrel=1
pkgdesc="Omakase Arch desktop on stock GNOME (experimental)"
arch=('any')
url="https://github.com/lookatitude/gnomarchi"
license=('MIT')
depends=(
  'python'
  'gnome-shell'
  'gnome-tweaks'
)
optdepends=(
  'ghostty: themed terminal'
  'neovim: seeded config'
  'starship: prompt theme'
  'paperwm: tiling shell extension'
  'localsend: share targets'
)
provides=('gnomarchi')
conflicts=('gnomarchi')
# Release asset name uses the git tag without the leading v (e.g. v0.0.1-beta.4 → 0.0.1-beta.4).
_tagver=0.0.1-beta.4
source=("${pkgname}-${_tagver}.tar.gz::https://github.com/lookatitude/gnomarchi/releases/download/v${_tagver}/gnomarchi-${_tagver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/gnomarchi-${_tagver}"

  local share="${pkgdir}/usr/share/gnomarchi"
  install -d "${share}"

  # Runtime tree must match install/overlay.sh lib copy (CLI imports these).
  local part
  for part in \
    theme plugin common bus menu apps agent config desktop plugins \
    applications assets features install skills extensions templates \
    plymouth bin; do
    if [[ -d "${part}" ]]; then
      cp -a "${part}" "${share}/"
    fi
  done
  for part in VERSION LICENSE README.md; do
    [[ -f "${part}" ]] && install -Dm644 "${part}" "${share}/${part}"
  done

  # Drop bytecode caches from the tarball copy.
  find "${share}" -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true

  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/gnomarchi" <<'EOF'
#!/usr/bin/env bash
export GNOMARCHI_ROOT=/usr/share/gnomarchi
exec /usr/share/gnomarchi/bin/gnomarchi "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/gnomarchi"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
