# Maintainer: gnomarchi contributors
# Experimental — not affiliated with Omarchy / Basecamp / DHH.
pkgname=gnomarchi
pkgver=0.0.1beta1
pkgrel=1
pkgdesc="Omakase Arch desktop on stock GNOME (experimental)"
arch=('any')
url="https://github.com/lookatitude/gnomarchi"
license=('MIT')
depends=(
  'python'
  'gnome-shell'
  'gnome-tweaks'
)
optdepends=(
  'ghostty: themed terminal'
  'neovim: seeded config'
  'starship: prompt theme'
  'paperwm: tiling shell extension'
  'localsend: share targets'
)
provides=('gnomarchi')
conflicts=('gnomarchi')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/lookatitude/gnomarchi/archive/refs/tags/v0.0.1-beta.1.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/gnomarchi-0.0.1-beta.1"

  install -d "${pkgdir}/usr/share/gnomarchi"
  cp -a bin desktop theme menu install config features VERSION LICENSE README.md \
    "${pkgdir}/usr/share/gnomarchi/"

  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/gnomarchi" <<'EOF'
#!/usr/bin/env bash
exec /usr/share/gnomarchi/bin/gnomarchi "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/gnomarchi"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
